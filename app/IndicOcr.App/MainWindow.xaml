<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IndicOcr.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          DragOver="Root_DragOver"
          Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: actions on the first row, language tick boxes on the second -->
        <Grid x:Name="Toolbar" Grid.Row="0" Padding="12,8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenFilesButton" Content="Open files" Click="OpenFiles_Click" />
                    <Button x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolder_Click" />
                </StackPanel>
                <TextBlock x:Name="HotkeyInfo" Grid.Column="1" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontSize="12" Opacity="0.8"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SnipButton" Content="Snip text" Click="Snip_Click" />
                    <Button x:Name="CopyButton" Content="Copy all text" Click="CopyAll_Click" />
                    <DropDownButton x:Name="ExportButton" Content="Export">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Save as text (.txt)" Click="SaveTxt_Click" />
                                <MenuFlyoutItem Text="Save as Word (.docx)" Click="SaveDocx_Click" />
                                <MenuFlyoutItem Text="Save as searchable PDF" Click="SavePdf_Click" />
                                <MenuFlyoutItem Text="Save tables as Excel (.xlsx)" Click="SaveXlsx_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="RedactToggle" Text="Redact ID numbers (Aadhaar, PAN, phone)"
                                                      Click="RedactToggle_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="LanguagePanel" Grid.Row="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
        </Grid>

        <!-- First-run page: shown when no models are found -->
        <ScrollViewer x:Name="FirstRunPanel" Grid.Row="1" Visibility="Collapsed">
            <StackPanel MaxWidth="720" Padding="24" Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="Language models not found" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap"
                           Text="Indic OCR works fully offline, but it needs the OCR model files on this PC. Copy the models folder to one of the places below, then press Check again. The folder must contain det.onnx plus one rec_xx.onnx and dict_xx.txt pair per language (for example rec_te.onnx and dict_te.txt for Telugu)." />
                <TextBlock x:Name="SearchedText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock TextWrapping="Wrap"
                           Text="You can also start the app with --models &quot;D:\path\to\models&quot; or set the INDICOCR_MODELS environment variable. Nothing is downloaded by this app." />
                <Button Content="Check again" Click="CheckAgain_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- Main work area -->
        <Grid x:Name="MainPanel" Grid.Row="1" ColumnSpacing="8" Padding="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Queue and drop zone -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="DropZone" Grid.Row="0" Height="110"
                        BorderThickness="2" CornerRadius="6"
                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}">
                    <TextBlock Text="Drop images, PDFs or folders here"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="QueueList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                           FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="ClearButton" Grid.Row="2" Content="Clear queue" Click="ClearQueue_Click" />
            </Grid>

            <!-- Page image with line boxes -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrevPageButton" Content="Previous" Click="PrevPage_Click" />
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Text="No page" />
                    <Button x:Name="NextPageButton" Content="Next" Click="NextPage_Click" />
                    <TextBlock x:Name="DetectedLabel" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Row="1" BorderThickness="1" CornerRadius="4"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="PageGrid">
                            <Image x:Name="PageImage" Stretch="Fill" />
                            <Canvas x:Name="BoxCanvas" />
                            <Canvas x:Name="RedactCanvas" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- Editable text lines -->
            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Recognised text (click a line to correct it)" VerticalAlignment="Center" />
                <ListView x:Name="LinesList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="LinesList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Text, Mode=TwoWay}"
                                         AcceptsReturn="False" TextWrapping="Wrap"
                                         GotFocus="LineBox_GotFocus" />
                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}"
                                           FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="12,6" ColumnSpacing="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FF107C10" CornerRadius="4" Padding="8,2">
                <TextBlock Text="Offline: nothing leaves this PC" Foreground="White" FontSize="12" />
            </Border>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="Ready" />
            <ProgressBar x:Name="BusyBar" Grid.Column="2" Width="120" IsIndeterminate="True"
                         Visibility="Collapsed" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
