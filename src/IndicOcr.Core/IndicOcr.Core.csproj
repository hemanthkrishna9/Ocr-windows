<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- A consumer that restores with -r <rid> (the app: win-x64, win-arm64) restores this project for that one RID too, which adds a
         runtime section to the lock file. Keep one lock file per RID so such a restore never rewrites packages.lock.json and locked mode works. -->
    <NuGetLockFilePath Condition="'$(RuntimeIdentifiers)' != '' and !$(RuntimeIdentifiers.Contains(';'))">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).lock.json</NuGetLockFilePath>
    <Description>Offline Indic OCR core (PaddleOCR on ONNX Runtime). No network code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IndicOcr.Core.Tests" />
  </ItemGroup>

</Project>
